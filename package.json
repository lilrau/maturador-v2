{
  "name": "maturador-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:build": "docker build -t maturador-v2 .",
    "docker:run": "docker run -p 3000:3000 --env-file .env maturador-v2",
